# Copy to .env and fill in. .env is gitignored — never commit real values.

# PhilSMS. Docs live at app.philsms.com, but account tokens authenticate against
# dashboard.philsms.com — see API_BASE in trackify/notify/philsms.py.
PHILSMS_API_TOKEN=
# Registered by hand in the PhilSMS dashboard (free, 2–3 days for telco approval).
# Also accepts a phone number with country code, so you can test before approval.
PHILSMS_SENDER_ID=

# Secret for signing QR payloads. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this invalidates every printed QR code.
TRACKIFY_QR_SECRET=

# Qt binding. pyside6 (LGPL) is the licensed default; pyqt6 is a dev fallback only.
QT_API=pyside6
