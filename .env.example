# Copy to .env and fill in. .env is gitignored — never commit real values.

# Does this station send real text messages?
#
#   true   texts really reach guardians, for every student whose consent box is ticked
#   false  nothing leaves the machine, whatever else is configured
#
# Only true / 1 / yes / on turn it on. ANYTHING ELSE, INCLUDING DELETING THIS LINE,
# MEANS FALSE — a station that has not been deliberately switched on stays silent.
#
# This replaced SMS_ALLOWLIST, whose empty value meant UNRESTRICTED: a .env missing
# one line texted every guardian on the roster. The default now fails the safe way.
#
# Consent is the other half and is per student, ticked in the roster screen. Both have
# to hold. Spend caps in config.toml still apply on top; those are a runaway brake.
SMS_LIVE=false

# Secret for signing QR payloads. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this invalidates every printed QR code.
TRACKIFY_QR_SECRET=

# Qt binding. pyside6 (LGPL) is the licensed default; pyqt6 is a dev fallback only.
QT_API=pyside6
