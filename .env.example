# Copy to .env and fill in. .env is gitignored — never commit real values.

# Numbers allowed to receive a real text, comma separated. 09XX / +639XX / 639XX all
# work. EMPTY MEANS EVERYONE — correct for production, dangerous while testing: the
# demo roster holds 19 valid-format Philippine numbers and an unli-text SIM has no
# cost brake to stop a loop bug reaching all of them. Set this while testing.
SMS_ALLOWLIST=

# Secret for signing QR payloads. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this invalidates every printed QR code.
TRACKIFY_QR_SECRET=

# Qt binding. pyside6 (LGPL) is the licensed default; pyqt6 is a dev fallback only.
QT_API=pyside6
