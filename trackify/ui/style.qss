/* TRACKIFY design system.
 *
 * Restrained and legible, not decorated. Default Qt widget styling reads as a 1990s
 * utility; this is what separates the product from a school project.
 *
 * Semantic colour is reserved for scan outcome -- green/blue/amber/red carry meaning
 * and are never used for decoration.
 */

/* --- base ------------------------------------------------------------- */

/* Type and colour inherit; background does NOT paint by default. A universal
 * background rule here would make every child panel opaque and hide the stage
 * colour shift underneath -- which is the whole mechanism that makes an outcome
 * readable across a corridor. */
QWidget {
    color: #E6EDEA;
    /* Segoe UI is Windows-only and IBM Plex is not installed on either machine, so on
     * the Pi both fell through to whatever fontconfig picked. Nunito Sans is Raspberry
     * Pi OS's own UI font and DejaVu Sans is always present, so the kiosk now renders
     * in a chosen face on both platforms rather than a different guess on each. */
    font-family: "Segoe UI", "Nunito Sans", "DejaVu Sans", "IBM Plex Sans",
                 system-ui, sans-serif;
    font-size: 15px;
}

/* Only these paint a background. */
QWidget#Kiosk { background: #0E1613; }
QWidget#Stage { background: #0E1613; }

/* Panels sitting on the stage stay see-through so the outcome colour shows. */
QWidget#Waiting, QWidget#Result { background: transparent; }
QLabel { background: transparent; }

/* --- waiting state ---------------------------------------------------- */

QLabel#WaitingTitle {
    font-size: 68px;
    font-weight: 600;
    color: #F2F7F5;
    letter-spacing: -1px;
}

QLabel#WaitingHint {
    font-size: 22px;
    color: #7C8F89;
}

QLabel#Clock {
    font-size: 120px;
    font-weight: 300;
    color: #F2F7F5;
    letter-spacing: -3px;
}

QLabel#ClockDate {
    font-size: 20px;
    color: #7C8F89;
    letter-spacing: 2px;
}

/* --- result state ----------------------------------------------------- */

QLabel#Avatar {
    font-size: 76px;
    font-weight: 600;
    color: #0E1613;
    border-radius: 90px;
    min-width: 180px;
    max-width: 180px;
    min-height: 180px;
    max-height: 180px;
    background: #E6EDEA;
}

QLabel#StudentName {
    font-size: 54px;
    font-weight: 600;
    color: #F2F7F5;
    letter-spacing: -0.5px;
}

QLabel#StudentSection {
    font-size: 26px;
    color: #9AACA6;
    letter-spacing: 1px;
}

QLabel#StudentAdviser {
    font-size: 20px;
    color: #7C8C87;
}

QLabel#Headline {
    font-size: 96px;
    font-weight: 700;
    letter-spacing: 4px;
}

QLabel#Detail {
    font-size: 30px;
    color: #C6D4CF;
}

QLabel#TimeText {
    font-size: 44px;
    font-weight: 300;
    color: #E6EDEA;
}

/* Outcome colours. Set via the Stage widget's dynamic "state" property so the whole
 * screen shifts, not just the text -- readable across a corridor at a glance. */

QWidget#Stage[state="in"]        { background: #0C2A1E; }
QWidget#Stage[state="out"]       { background: #0B2233; }
QWidget#Stage[state="already"]   { background: #2E2408; }
QWidget#Stage[state="unknown"]   { background: #33130F; }
QWidget#Stage[state="override"]  { background: #2E2408; }
QWidget#Stage[state="neutral"]   { background: #171F1C; }
/* A ground that says "different mode", not one that implies an outcome --
   nothing has been decided yet when this page is up. */
QWidget#Stage[state="inspect"]   { background: #12161F; }
QWidget#Stage[state="records"]   { background: #10161A; }

QLabel#Headline[state="in"]       { color: #4ADE80; }
QLabel#Headline[state="out"]      { color: #58B6F5; }
QLabel#Headline[state="already"]  { color: #F5C451; }
QLabel#Headline[state="unknown"]  { color: #F87171; }
QLabel#Headline[state="override"] { color: #F5C451; }
QLabel#Headline[state="neutral"]  { color: #9AACA6; }

/* --- camera preview --------------------------------------------------- */

/* #CameraPanel itself stays transparent. Only the inner stage paints, and only
 * because a video surface needs something behind it while the first frame arrives --
 * an opaque wrapper here would sit on the stage and hide the outcome colour, which is
 * exactly the bug that made the result panel unreadable once before. */
QWidget#CameraPanel { background: transparent; }

QWidget#CameraStage {
    background: #060B09;
    border: 2px solid #24332E;
    border-radius: 10px;
}

/* The scene view paints nothing of its own, so the rounded stage border above stays
 * the visible edge of the preview. */
QGraphicsView#CameraView {
    background: transparent;
    border: none;
}

QLabel#CameraStatus {
    font-size: 20px;
    font-weight: 600;
    color: #F5C451;
    background: transparent;
}

QLabel#CameraHint {
    font-size: 16px;
    color: #7C8F89;
    letter-spacing: 0.5px;
    background: transparent;
}

/* --- status bar ------------------------------------------------------- */

QFrame#StatusBar {
    background: #0A100E;
    border-top: 1px solid #1E2A26;
    min-height: 46px;
    max-height: 46px;
}

QLabel.status {
    font-size: 13px;
    color: #7C8F89;
    letter-spacing: 0.5px;
}

QLabel#StatusUnsent {
    font-size: 13px;
    font-weight: 600;
    color: #7C8F89;
}

/* Unsent backlog turns amber so a network outage is noticed the same day. */
QLabel#StatusUnsent[alert="true"] {
    color: #F5C451;
}

QLabel#StatusProvider {
    font-size: 13px;
    font-weight: 600;
    color: #7C8F89;
}

/* A GSM module that is unplugged or not answering turns amber. Without it the bar reads
 * a confident "SMS: gsm" all day while no parent is being told anything. */
QLabel#StatusProvider[alert="true"] {
    color: #F5C451;
}

QLabel#StatusCamera {
    font-size: 13px;
    font-weight: 600;
    color: #7C8F89;
}

/* A camera that has died turns amber, so it is noticed the same morning rather than
 * inferred afterwards from missing attendance data. */
QLabel#StatusCamera[alert="true"] {
    color: #F5C451;
}

QLabel#StatusSep {
    color: #2A3733;
}

/* --- hidden scanner input --------------------------------------------- */

/* The scanner input is deliberately invisible. Every property the general QLineEdit
   rule below sets has to be cancelled here explicitly -- min-height in particular
   will fight max-height and put a stray input box under the clock on the gate. */
QLineEdit#ScanInput {
    background: transparent;
    border: none;
    border-radius: 0;
    color: transparent;
    selection-background-color: transparent;
    padding: 0;
    margin: 0;
    min-height: 0;
    max-height: 1px;
}

QLabel#ScreeningPrompt {
    font-size: 18px;
    color: #9AACA6;
}


QLabel#DialogHeading {
    font-size: 22px;
    font-weight: 600;
}

QLabel#DialogHint {
    font-size: 14px;
    color: #7C8C87;
    padding-bottom: 6px;
}

QLabel#DialogError {
    font-size: 14px;
    color: #F58F58;
}

/* A consequence the operator has to act on AWAY from this screen -- reprinting a
   card. Amber rather than the error red: nothing has gone wrong, but ignoring it
   leaves a student at the gate holding a code that no longer resolves. */
QLabel#DialogWarning {
    font-size: 14px;
    color: #F5C451;
    background: #2A2718;
    border: 1px solid #4A4426;
    border-radius: 6px;
    padding: 8px 10px;
}

/* --- screening buttons -------------------------------------------------- */
/* Generous for a mouse but readable across a corridor: the operator glances
   between the bag and this row, not at it. */

QPushButton#ScreeningPrimary {
    font-size: 20px;
    font-weight: 600;
    color: #0E1613;
    background: #E6EDEA;
    border: none;
    border-radius: 6px;
    padding: 14px 26px;
    min-width: 190px;
}
QPushButton#ScreeningPrimary:hover  { background: #FFFFFF; }
QPushButton#ScreeningPrimary:pressed { background: #B9C7C2; }

QPushButton#ScreeningCategory {
    font-size: 17px;
    font-weight: 600;
    color: #E6EDEA;
    background: transparent;
    border: 2px solid #7C8C87;
    border-radius: 6px;
    padding: 9px 20px;
    min-width: 104px;
}
QPushButton#ScreeningCategory:hover   { border-color: #E6EDEA; }
QPushButton#ScreeningCategory:pressed { background: #2A3A35; }

/* Not screened / Back. Quiet on purpose -- an escape hatch must be reachable
   without ever looking like one of the normal answers. */
QPushButton#ScreeningMinor {
    font-size: 15px;
    color: #9AACA6;
    background: transparent;
    border: 1px solid #4A5A55;
    border-radius: 5px;
    padding: 8px 16px;
}
QPushButton#ScreeningMinor:hover { color: #E6EDEA; border-color: #7C8C87; }

QLabel#ScreeningGroup {
    font-size: 13px;
    font-weight: 600;
    color: #7C8C87;
    letter-spacing: 1.5px;
    padding-top: 4px;
}

QLabel#ScreeningPrompt[alert="true"] {
    font-size: 19px;
    font-weight: 600;
    color: #F58F58;
}

/* --- bag inspection page ------------------------------------------------ */

QLabel#InspectAvatar {
    font-size: 24px;
    font-weight: 600;
    color: #0E1613;
    border-radius: 26px;
    min-width: 52px;  max-width: 52px;
    min-height: 52px; max-height: 52px;
    background: #E6EDEA;
}

QLabel#InspectStudent {
    font-size: 26px;
    font-weight: 600;
    color: #E6EDEA;
}

QLabel#InspectSection {
    font-size: 20px;
    color: #8A97A8;
    padding-left: 4px;
}

QLabel#InspectHeading {
    font-size: 34px;
    font-weight: 600;
    color: #E6EDEA;
}

QLabel#InspectRule {
    font-size: 16px;
    color: #8A97A8;
    padding-top: 2px;
}

QLabel#InspectGroup {
    font-size: 13px;
    font-weight: 600;
    color: #7C8C87;
    letter-spacing: 2px;
    padding-bottom: 8px;
}

/* Cards. Hover and pressed states are not decoration: without visible feedback a
   hurried operator taps twice and the second click lands on the next screen. */
QToolButton#InspectCard, QToolButton#InspectCardDanger {
    font-size: 17px;
    font-weight: 600;
    color: #E6EDEA;
    background: #1B2130;
    border: 1px solid #2C3547;
    border-radius: 10px;
    padding: 18px 10px 14px 10px;
    min-width: 148px;
    min-height: 118px;
}
QToolButton#InspectCard:hover {
    background: #232B3D;
    border-color: #4B5B78;
}
QToolButton#InspectCard:pressed { background: #2B3550; }

QToolButton#InspectCardDanger {
    color: #F0918F;
    border-color: #57302F;
}
QToolButton#InspectCardDanger:hover {
    background: #2A1E20;
    border-color: #8C4A48;
}
QToolButton#InspectCardDanger:pressed { background: #372628; }

/* ======================================================================== */
/* Records: tables, inputs, toolbar                                          */
/* ======================================================================== */

QLabel#PageTitle {
    font-size: 24px;
    font-weight: 600;
    color: #E6EDEA;
}

QLabel#PageSubtitle {
    font-size: 16px;
    color: #7C8C87;
}

QWidget#Legend {
    border-top: 1px solid #232B31;
    border-bottom: 1px solid #232B31;
    padding: 7px 0;
}

QLabel#LegendText  { font-size: 13px; color: #8A97A8; }
QLabel#LegendNote  { font-size: 13px; color: #6B7885; font-style: italic; }

/* --- tables ------------------------------------------------------------- */
/* There was no rule for a table anywhere in this file, which is why these read
   as a developer tool rather than as part of the product. */

QTableWidget, QTableView {
    background: #12161B;
    alternate-background-color: #151A20;
    color: #D8E0DD;
    border: 1px solid #232B31;
    border-radius: 8px;
    gridline-color: transparent;
    font-size: 14px;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 0px;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: #22303C;
    color: #FFFFFF;
}

QHeaderView { background: transparent; }

QHeaderView::section {
    background: #1A2027;
    color: #8A97A8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.6px;
    /* Horizontal padding stays small: Qt folds it into the minimum section width,
       so a generous value here silently widens all 31 day columns. */
    padding: 7px 2px;
    border: none;
    border-bottom: 1px solid #2A343C;
}

QHeaderView::section:vertical {
    text-align: left;
    padding-left: 12px;
    color: #D8E0DD;
    font-weight: 500;
    letter-spacing: 0;
    border-right: 1px solid #2A343C;
    border-bottom: 1px solid #1E252B;
}

QTableCornerButton::section {
    background: #1A2027;
    border: none;
    border-bottom: 1px solid #2A343C;
}

QScrollBar:horizontal, QScrollBar:vertical {
    background: transparent;
    border: none;
}
QScrollBar:horizontal { height: 10px; margin: 0; }
QScrollBar:vertical   { width: 10px;  margin: 0; }
QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background: #2F3A44;
    border-radius: 5px;
    min-width: 30px;
    min-height: 30px;
}
QScrollBar::handle:hover { background: #3F4C58; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; }

/* --- inputs ------------------------------------------------------------- */
/* Nothing styled these before, so every dialog in the application -- correction,
   password, incident, custody -- was showing raw Qt widgets. */

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background: #171D24;
    color: #E6EDEA;
    border: 1px solid #2A343C;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 20px;
    font-size: 14px;
    selection-background-color: #2F5D7C;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: #4E7FA8;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #5C666E;
    background: #14181D;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #171D24;
    color: #E6EDEA;
    border: 1px solid #2A343C;
    selection-background-color: #22303C;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button { width: 16px; border: none; }

QFormLayout QLabel { color: #9AACA6; }

/* --- toolbar buttons ----------------------------------------------------- */

QPushButton#ToolbarButton, QPushButton#ToolbarPrimary, QPushButton#ToolbarQuiet {
    font-size: 14px;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton#ToolbarButton {
    color: #D8E0DD;
    background: #1C242C;
    border: 1px solid #2A343C;
}
QPushButton#ToolbarButton:hover  { background: #242E38; border-color: #3C4954; }
QPushButton#ToolbarButton:pressed { background: #2B3742; }

QPushButton#ToolbarPrimary {
    color: #0E1613;
    background: #7FB6E8;
    border: 1px solid #7FB6E8;
    font-weight: 600;
}
QPushButton#ToolbarPrimary:hover   { background: #98C6F0; }
QPushButton#ToolbarPrimary:pressed { background: #6BA0D0; }

QPushButton#ToolbarQuiet {
    color: #8A97A8;
    background: transparent;
    border: 1px solid transparent;
}
QPushButton#ToolbarQuiet:hover { color: #E6EDEA; border-color: #2A343C; }

/* --- dialogs ------------------------------------------------------------- */

QDialog {
    background: #12161B;
}

QDialogButtonBox QPushButton {
    font-size: 14px;
    color: #D8E0DD;
    background: #1C242C;
    border: 1px solid #2A343C;
    border-radius: 6px;
    padding: 7px 20px;
    min-width: 78px;
}
QDialogButtonBox QPushButton:hover { background: #242E38; }
QDialogButtonBox QPushButton:default {
    color: #0E1613;
    background: #7FB6E8;
    border-color: #7FB6E8;
    font-weight: 600;
}
QDialogButtonBox QPushButton:default:hover { background: #98C6F0; }
